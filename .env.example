# Copy this file to .env and fill in your own values. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4.1-mini
LLM_ENABLED=true

# Required once before managing X Cookies from the web UI. This is not the
# Cookie itself; generate a Fernet key and keep it private.
CREDENTIAL_ENCRYPTION_KEY=

# Optional local overrides
APP_DATABASE_PATH=data/rss_news.db
APP_TIMEZONE=Asia/Shanghai
