+import type { DataItem, Route } from '@/types';
+import parser from '@/utils/rss-parser';
+
+const USER_NAME = /^[A-Za-z0-9_]+$/;
+
+export const route: Route = {
+    path: '/u/:username',
+    categories: ['bbs'],
+    example: '/reddit/u/spez',
+    parameters: { username: '用户名，不包含 u/' },
+    features: {
+        requireConfig: false,
+        requirePuppeteer: false,
+        antiCrawler: false,
+        supportBT: false,
+        supportPodcast: false,
+        supportScihub: false,
+    },
+    name: 'User submissions',
+    maintainers: ['NewsRSSHub'],
+    handler,
+};
+
+async function handler(ctx) {
+    const username = ctx.req.param('username');
+    if (!USER_NAME.test(username)) {
+        throw new Error('无效的 Reddit 用户名');
+    }
+
+    const url = `https://www.reddit.com/user/${username}/submitted/.rss`;
+    const feed = await parser.parseURL(url);
+    return {
+        title: feed.title || `Reddit · u/${username}`,
+        link: `https://www.reddit.com/user/${username}/`,
+        description: feed.description,
+        item: feed.items as DataItem[],
+    };
+}
