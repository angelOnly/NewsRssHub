@@ -0,0 +1,38 @@
+import type { DataItem, Route } from '@/types';
+import parser from '@/utils/rss-parser';
+
+import { getManagedFeedUrl } from './runtime';
+
+export const route: Route = {
+    path: '/rss/:key',
+    categories: ['other'],
+    example: '/newsrsshub/rss/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef',
+    parameters: { key: 'NewsRSSHub 生成的 RSS 来源标识' },
+    features: {
+        requireConfig: [
+            {
+                name: 'NEWSRSSHUB_RUNTIME_DIR',
+                description: 'NewsRSSHub 共享运行时目录',
+            },
+        ],
+        requirePuppeteer: false,
+        antiCrawler: false,
+        supportBT: false,
+        supportPodcast: false,
+        supportScihub: false,
+    },
+    name: '受管 RSS / Atom 来源',
+    maintainers: ['NewsRSSHub'],
+    handler,
+};
+
+async function handler(ctx) {
+    const url = await getManagedFeedUrl(ctx.req.param('key'));
+    const feed = await parser.parseURL(url);
+    return {
+        title: feed.title || 'NewsRSSHub RSS 来源',
+        link: feed.link || url,
+        description: feed.description,
+        item: feed.items as DataItem[],
+    };
+}
