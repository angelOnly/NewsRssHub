@@ -0,0 +1,35 @@
+import { readFile } from 'node:fs/promises';
+import path from 'node:path';
+
+import ConfigNotFoundError from '@/errors/types/config-not-found';
+
+const RUNTIME_DIRECTORY_ENV = 'NEWSRSSHUB_RUNTIME_DIR';
+const X_CREDENTIAL_FILENAME = 'x-twitter.json';
+
+export const hasNewsRssHubRuntimeToken = () => Boolean(process.env[RUNTIME_DIRECTORY_ENV]?.trim());
+
+export async function getNewsRssHubRuntimeToken(): Promise<string | undefined> {
+    const directory = process.env[RUNTIME_DIRECTORY_ENV]?.trim();
+    if (!directory) {
+        return undefined;
+    }
+
+    const credentialPath = path.join(directory, X_CREDENTIAL_FILENAME);
+    let raw: string;
+    try {
+        raw = await readFile(credentialPath, 'utf8');
+    } catch {
+        throw new ConfigNotFoundError('NewsRSSHub X 凭据文件不可读取');
+    }
+
+    try {
+        const document = JSON.parse(raw) as { auth_token?: unknown };
+        const authToken = typeof document.auth_token === 'string' ? document.auth_token.trim() : '';
+        if (!authToken) {
+            throw new Error('missing auth_token');
+        }
+        return authToken;
+    } catch {
+        throw new ConfigNotFoundError('NewsRSSHub X 凭据文件格式无效');
+    }
+}
