+import type { DataItem, Route } from '@/types';
+import parser from '@/utils/rss-parser';
+
+const SUBREDDIT_NAME = /^[A-Za-z0-9_]{2,21}$/;
+
+export const route: Route = {
+    path: '/r/:subreddit',
+    categories: ['bbs'],
+    example: '/reddit/r/OpenAI',
+    parameters: { subreddit: '社区名称，不包含 r/' },
+    features: {
+        requireConfig: false,
+        requirePuppeteer: false,
+        antiCrawler: false,
+        supportBT: false,
+        supportPodcast: false,
+        supportScihub: false,
+    },
+    name: 'Subreddit',
+    maintainers: ['NewsRSSHub'],
+    handler,
+};
+
+async function handler(ctx) {
+    const subreddit = ctx.req.param('subreddit');
+    if (!SUBREDDIT_NAME.test(subreddit)) {
+        throw new Error('无效的 Reddit 社区名称');
+    }
+
+    const url = `https://www.reddit.com/r/${subreddit}/.rss`;
+    const feed = await parser.parseURL(url);
+    return {
+        title: feed.title || `Reddit · r/${subreddit}`,
+        link: `https://www.reddit.com/r/${subreddit}/`,
+        description: feed.description,
+        item: feed.items as DataItem[],
+    };
+}
