+import type { Route } from '@/types';
+import twitterWebApi from '@/routes/twitter/api/web-api/api';
+import { getNewsRssHubRuntimeToken } from '@/routes/twitter/api/web-api/newsrsshub-runtime';
+
+export const route: Route = {
+    path: '/x/validate',
+    categories: ['other'],
+    example: '/newsrsshub/x/validate',
+    features: {
+        requireConfig: [
+            {
+                name: 'NEWSRSSHUB_RUNTIME_DIR',
+                description: 'NewsRSSHub 共享运行时目录',
+            },
+        ],
+        requirePuppeteer: false,
+        antiCrawler: false,
+        supportBT: false,
+        supportPodcast: false,
+        supportScihub: false,
+    },
+    name: 'X 凭据校验',
+    maintainers: ['NewsRSSHub'],
+    handler,
+};
+
+async function handler(ctx) {
+    // 凭据更新后必须绕过 RSSHub 路由缓存，才能真正验证当前文件中的 token。
+    ctx.header('Cache-Control', 'no-cache');
+    await getNewsRssHubRuntimeToken();
+    await twitterWebApi.init();
+    await twitterWebApi.getUserTweets('OpenAI', { count: 1 });
+    return {
+        title: 'NewsRSSHub X 凭据校验',
+        link: 'https://x.com/OpenAI',
+        item: [],
+        allowEmpty: true,
+    };
+}
