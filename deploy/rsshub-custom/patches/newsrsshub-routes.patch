new file mode 100644
--- /dev/null
+++ b/lib/routes/newsrsshub/runtime.ts
@@ -0,0 +1,46 @@
+import { readFile } from 'node:fs/promises';
+import path from 'node:path';
+
+import ConfigNotFoundError from '@/errors/types/config-not-found';
+
+const RUNTIME_DIRECTORY_ENV = 'NEWSRSSHUB_RUNTIME_DIR';
+const FEED_MANIFEST_FILENAME = 'rss-feeds.json';
+const FEED_KEY = /^[a-f0-9]{64}$/;
+
+type FeedManifest = {
+    feeds?: Record<string, { url?: unknown }>;
+};
+
+const runtimeDirectory = () => {
+    const directory = process.env[RUNTIME_DIRECTORY_ENV]?.trim();
+    if (!directory) {
+        throw new ConfigNotFoundError('NewsRSSHub 运行时目录尚未配置');
+    }
+    return directory;
+};
+
+export async function getManagedFeedUrl(key: string): Promise<string> {
+    if (!FEED_KEY.test(key)) {
+        throw new Error('无效的 NewsRSSHub RSS 来源标识');
+    }
+
+    let raw: string;
+    try {
+        raw = await readFile(path.join(runtimeDirectory(), FEED_MANIFEST_FILENAME), 'utf8');
+    } catch {
+        throw new ConfigNotFoundError('NewsRSSHub RSS 来源清单不可读取');
+    }
+
+    try {
+        const manifest = JSON.parse(raw) as FeedManifest;
+        const value = manifest.feeds?.[key]?.url;
+        const url = typeof value === 'string' ? value.trim() : '';
+        const parsed = new URL(url);
+        if (!url || !['http:', 'https:'].includes(parsed.protocol)) {
+            throw new Error('invalid feed url');
+        }
+        return url;
+    } catch {
+        throw new Error('NewsRSSHub RSS 来源清单格式无效或来源不存在');
+    }
+}
